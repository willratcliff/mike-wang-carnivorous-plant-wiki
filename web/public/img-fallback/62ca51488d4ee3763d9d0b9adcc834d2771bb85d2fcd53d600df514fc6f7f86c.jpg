    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body,
      p,
      table,
      blockquote,
      address,
      pre,
      iframe,
      form,
      figure,
      dl,
      dd,
      dt,
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        margin: 0;
      }

      ul,
      ol {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      img {
        border-style: none;
      }

      html {
        font-size: 62.5%;
        line-height: 1.56;
        color: #171717;
        background: #fff;
      }

      body {
        font-size: 1.6rem;
        letter-spacing: 0.05em;
        -webkit-text-size-adjust: 100%;
        font-family: "Helvetica Neue", Arial, "Hiragino Kaku Gothic ProN",
          "Hiragino Sans", Meiryo, sans-serif;
        overflow-wrap: anywhere;
        word-break: normal;
        line-break: strict;
      }

      table {
        border-collapse: collapse;
        border-spacing: 0;
        width: 100%;
      }

      a,
      a:link,
      a:visited {
        color: #005eeb;
        text-decoration: underline;
      }

      a:hover,
      a:active {
        color: #ec4645;
        text-decoration: none;
      }

      .sp_display {
        display: none;
      }

      .pc_display {
        display: block;
      }

      @media (max-width: 768px) {
        .sp_display {
          display: block;
        }

        .pc_display {
          display: none;
        }
      }

      .margin_top8 {
        margin-top: 8px;
      }

      .margin_top10 {
        margin-top: 10px;
      }

      .margin_top15 {
        margin-top: 15px;
      }

      .margin_top20 {
        margin-top: 20px;
      }

      .margin_top30 {
        margin-top: 30px;
      }

      .margin_top40 {
        margin-top: 40px;
      }

      .margin_bottom10 {
        margin-bottom: 10px;
      }

      .margin_bottom15 {
        margin-bottom: 15px;
      }

      .margin_bottom20 {
        margin-bottom: 20px;
      }

      .margin_bottom30 {
        margin-bottom: 30px;
      }

      .margin_bottom40 {
        margin-bottom: 40px;
      }

      #container {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      header {
        margin-top: 120px;
        margin-bottom: 72px;
      }

      @media (max-width: 768px) {
        header {
          margin-bottom: 48px;
        }
      }

      .header_service_name svg{
        margin-left: auto;
        margin-right: auto;
        display: block;
        height: 57px;
        width: auto;
      }

      .max_width_set {
        margin-left: auto;
        margin-right: auto;
        max-width: 960px;
        width: calc(100% - 24px);
      }

      .service_closure .max_width_set {
        max-width: 980px;
      }

      footer {
        margin-top: auto;
        padding-top: 200px;
      }

      @media (max-width: 768px) {
        footer {
          padding-top: 300px;
        }
      }

      .footer_inner {
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 12px;
        border-top: 1px solid #dfdfdf;
        min-height: 68px;
        display: grid;
        justify-content: center;
        align-items: end;
        color: #a6a6a6;
        line-height: 1.2;
      }

      .default_head {
        margin-bottom: 40px;
        margin-left: auto;
        margin-right: auto;
        padding: 0 0 12px;
        max-width: 1000px;
        width: calc(100% - 24px);
        text-align: center;
        border-bottom: 1px solid #d02c27;
        font-size: 2.4rem;
        font-weight: bold;
      }

      .service_closure .default_head {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0 1em;
      }

      .content_section:not(:last-child) {
        margin-bottom: 140px;
      }

      .service_closure_text {
        margin-bottom: 24px;
        font-size: 2rem;
      }

      .service_closure_text strong {
        margin-left: 6px;
        margin-right: 6px;
        color: #d02c27;
        font-weight: normal;
      }

      .service_lists {
        margin-bottom: 60px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
      }

      @media (max-width: 960px) {
        .service_lists {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      @media (max-width: 768px) {
        .service_lists {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      .service_list {
        padding: 20px 24px;
        border: 1px solid #dfdfdf;
        border-radius: 5px;
        display: flex;
        gap: 8px 0;
        align-items: start;
        flex-direction: column;
      }

      @media (max-width: 768px) {
        .service_list {
          padding-left: 16px;
          padding-right: 16px;
        }
      }

      .service_name {
        font-size: 1.6rem;
        line-height: 1.2;
        font-weight: normal;
      }

      .service_detail {
        font-size: 1.4rem;
        line-height: 1.1;
        color: hsl(0 0% 30% / 1);
      }

      .service_closure_detail {
        margin-left: auto;
        margin-right: auto;
        max-width: 960px;
      }

      .service_closure_detail p:not(:last-child) {
        margin-bottom: 32px;
      }

      .web_detail_text {
        margin-bottom: 40px;
      }

      .web_img_wrap {
        margin-bottom: 96px;
      }

      .web_img_wrap img {
        margin-left: auto;
        margin-right: auto;
        display: block;
        width: 100%;
        height: auto;
      }

      @media (max-width: 768px) {
        .web_detail_text {
          margin-bottom: 18px;
        }

        .web_img_wrap img {
          max-width: 378px;
        }

        .web_img_wrap {
          margin-bottom: 72px;
        }
      }

      .web_link_wrap {
        text-align: center;
      }

      .web_link_wrap p {
        margin-bottom: 20px;
      }

      a.web_link_btn {
        margin-left: auto;
        margin-right: auto;
        padding: 16px 12px;
        display: grid;
        width: 100%;
        max-width: 360px;
        color: #f3565a;
        border: 3px solid #f3565a;
        background-color: #fff;
        text-align: center;
        font-size: 2.4rem;
        line-height: 1.2;
        font-weight: bold;
        border-radius: 5px;
        transition: all 0.2s ease-out;
        text-decoration: none;
      }

      a.web_link_btn:hover {
        text-decoration: none;
          box-shadow: 0px 4px 18px 0px rgba(243, 88, 93,0.25);
      }
    </style>
  </head>

