---
import '~/styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Path of the hero image (used for social card preview). */
  ogImage?: string | null;
}

const { title, description, ogImage } = Astro.props;
const fullTitle = title === 'Home'
  ? "Carnivorous Plant Clone Wiki"
  : `${title} — Carnivorous Plant Clone Wiki`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Pagefind UI styles. The bundle is generated at build time and
        served from /pagefind/. In dev mode (no build run yet) this 404s
        gracefully. */}
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site" data-pagefind-ignore>
      <div class="inner">
        <a href="/" class="brand">Carnivorous Plant Clone Wiki</a>
        <span class="spacer"></span>
        <nav>
          <a href="/sarracenia/"><em>Sarracenia</em></a>
          <a href="/cephalotus/"><em>Cephalotus</em></a>
          <a href="/darlingtonia/"><em>Darlingtonia</em></a>
          <a href="/dionaea/"><em>Dionaea</em></a>
        </nav>
        <button class="search-trigger" id="search-trigger" aria-label="Open search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span>Search</span>
          <kbd>⌘K</kbd>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site" data-pagefind-ignore>
      <div class="inner">
        Clones described by
        <a href="https://sarracenia.proboards.com/user/11">Mike Wang</a>
        on the
        <a href="https://sarracenia.proboards.com">Sarracenia Forum</a>,
        archived for posterity. Most entries are AI-extracted from forum
        posts and await Mike's review.
      </div>
    </footer>

    {/* Search modal — Pagefind UI mounts inside #search-pagefind. */}
    <div id="search-modal" class="search-modal" hidden role="dialog" aria-modal="true" aria-label="Search">
      <div class="search-backdrop" data-search-close></div>
      <div class="search-panel">
        <button class="search-close" data-search-close aria-label="Close">×</button>
        <div id="search-pagefind"></div>
        <div id="search-fallback" class="search-fallback" hidden>
          Search index not found. Run <code>npm run build</code> + <code>npm run preview</code>
          to see search results.
        </div>
      </div>
    </div>

    <script>
      // Global image error handler. If a Flickr/etc URL rots, mark
      // the <img> with a .broken class so CSS shows a placeholder
      // gradient instead of the browser's default broken icon.
      // Uses capture phase because `error` events don't bubble.
      window.addEventListener(
        'error',
        (e) => {
          const t = e.target as HTMLElement | null;
          if (t && t.tagName === 'IMG') {
            t.classList.add('broken');
            (t as HTMLImageElement).removeAttribute('src');
          }
        },
        { capture: true }
      );
    </script>
    <script>
      // Lazy-load Pagefind UI when the modal first opens. This keeps
      // the initial page load fast — Pagefind's JS bundle is only
      // fetched when the user actually searches.
      const trigger = document.getElementById('search-trigger');
      const modal = document.getElementById('search-modal');
      const fallback = document.getElementById('search-fallback');
      let pagefindLoaded = false;
      let pagefindLoadFailed = false;

      const loadPagefind = async () => {
        if (pagefindLoaded || pagefindLoadFailed) return;
        try {
          // @ts-ignore — global injected by /pagefind/pagefind-ui.js
          await new Promise<void>((resolve, reject) => {
            const s = document.createElement('script');
            s.src = '/pagefind/pagefind-ui.js';
            s.onload = () => resolve();
            s.onerror = () => reject(new Error('Pagefind script failed to load'));
            document.head.appendChild(s);
          });
          // @ts-ignore
          new (window as any).PagefindUI({
            element: '#search-pagefind',
            showImages: true,
            resetStyles: false,
            showSubResults: false,
            placeholder: 'Search clones, traits, photographers…',
          });
          pagefindLoaded = true;
        } catch (err) {
          pagefindLoadFailed = true;
          if (fallback) fallback.hidden = false;
          console.warn('Pagefind UI failed to load:', err);
        }
      };

      const openSearch = async () => {
        if (!modal) return;
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        await loadPagefind();
        // Focus the input that Pagefind UI rendered.
        const input = modal.querySelector<HTMLInputElement>('input.pagefind-ui__search-input');
        if (input) {
          input.focus();
        } else {
          // If Pagefind didn't load, focus the close button so Esc works.
          (modal.querySelector('.search-close') as HTMLElement | null)?.focus();
        }
      };

      const closeSearch = () => {
        if (!modal) return;
        modal.hidden = true;
        document.body.style.overflow = '';
      };

      trigger?.addEventListener('click', openSearch);
      modal?.querySelectorAll('[data-search-close]').forEach((el) => {
        el.addEventListener('click', closeSearch);
      });
      document.addEventListener('keydown', (e) => {
        const isMac = /mac|iphone|ipad|ipod/i.test(navigator.userAgent);
        const cmdOrCtrl = isMac ? e.metaKey : e.ctrlKey;
        if (cmdOrCtrl && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (modal?.hidden) openSearch();
          else closeSearch();
        }
        if (e.key === 'Escape' && !modal?.hidden) closeSearch();
      });
    </script>

    <style is:global>
      /* ---- search trigger button in header ---- */
      .search-trigger {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 0.9rem;
        color: var(--muted);
        cursor: pointer;
        font-family: inherit;
        transition: border-color 120ms ease, color 120ms ease, background 120ms ease;
      }
      .search-trigger:hover {
        border-color: var(--accent);
        color: var(--accent);
        background: #fff;
      }
      .search-trigger kbd {
        font-family: var(--mono);
        font-size: 0.78rem;
        padding: 1px 6px;
        border-radius: 4px;
        background: #fff;
        border: 1px solid var(--border);
        color: var(--muted);
      }
      @media (max-width: 640px) {
        .search-trigger span,
        .search-trigger kbd { display: none; }
        .search-trigger { padding: 8px; }
      }

      /* ---- modal ---- */
      .search-modal[hidden] { display: none; }
      .search-modal {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 80px 16px 16px 16px;
        overflow-y: auto;
      }
      .search-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(20, 26, 22, 0.55);
        backdrop-filter: blur(2px);
      }
      .search-panel {
        position: relative;
        width: 100%;
        max-width: 720px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        padding: 24px 24px 28px 24px;
      }
      .search-close {
        position: absolute;
        top: 8px;
        right: 12px;
        background: transparent;
        border: none;
        font-size: 1.6rem;
        line-height: 1;
        color: var(--muted);
        cursor: pointer;
        padding: 4px 8px;
      }
      .search-close:hover { color: var(--fg); }
      .search-fallback {
        margin-top: 16px;
        padding: 12px 14px;
        background: var(--warn-bg);
        border-left: 3px solid var(--warn);
        color: var(--warn);
        font-size: 0.92rem;
      }
      .search-fallback code {
        background: rgba(0,0,0,0.05);
        padding: 1px 5px;
        border-radius: 3px;
        font-family: var(--mono);
        font-size: 0.88em;
      }

      /* ---- Pagefind UI overrides — match our design language ---- */
      :root {
        --pagefind-ui-scale: 0.85;
        --pagefind-ui-primary: #2a6f4a;
        --pagefind-ui-text: #1a1a1a;
        --pagefind-ui-background: #fff;
        --pagefind-ui-border: #e3e3df;
        --pagefind-ui-tag: #f0f7f3;
        --pagefind-ui-border-width: 1px;
        --pagefind-ui-border-radius: 8px;
        --pagefind-ui-image-border-radius: 6px;
        --pagefind-ui-image-box-ratio: 4 / 3;
        --pagefind-ui-font: var(--sans);
      }
      .pagefind-ui__result-title {
        font-family: var(--serif);
      }
    </style>
  </body>
</html>
