---
import { resolveImageUrl } from '~/lib/photos';

interface Photo {
  path: string;
  caption: string;
  photographer: string;
  source_post_id: number;
  favorite?: boolean;
}

interface Props {
  href: string;
  title: string;
  subtitle?: string | null;
  photos?: Photo[];
  reviewed?: boolean;
  /** Optional filter values for client-side faceting. */
  filterState?: string | null;
  filterBreeder?: string | null;
  filterType?: string | null;
}

const {
  href,
  title,
  subtitle,
  photos,
  reviewed,
  filterState,
  filterBreeder,
  filterType,
} = Astro.props;

const photo = photos?.find((p) => p.favorite) ?? photos?.[0];
const thumbUrl = photo ? resolveImageUrl(photo.path) : null;
const hasFavorite = photos?.some((p) => p.favorite) ? 'yes' : 'no';
---

<a
  href={href}
  class="card-link"
  data-filter-card
  data-filter-state={filterState ?? ''}
  data-filter-breeder={filterBreeder ?? ''}
  data-filter-type={filterType ?? ''}
  data-filter-hasFavorite={hasFavorite}
>
  <div class="thumb">
    {thumbUrl ? (
      <img src={thumbUrl} alt={title} loading="lazy" referrerpolicy="no-referrer" />
    ) : (
      <div class="thumb-empty"></div>
    )}
    {reviewed === false && <span class="badge">draft</span>}
  </div>
  <div class="meta">
    <span class="title">{title}</span>
    {subtitle && <span class="subtitle">{subtitle}</span>}
  </div>
</a>

<style>
  .card-link {
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    color: var(--fg);
    border-bottom: 1px solid var(--border);
    transition: transform 120ms ease, box-shadow 120ms ease, border-color 120ms ease;
    text-decoration: none;
  }
  .card-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent);
  }
  .thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #e8e8e0;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .thumb-empty {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e0ddc8 25%, #cdd5c2 100%);
  }
  .badge {
    position: absolute;
    top: 8px;
    right: 8px;
    background: rgba(177, 90, 0, 0.92);
    color: #fff;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: 999px;
    font-weight: 600;
  }
  .meta {
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .title {
    font-family: var(--serif);
    font-size: 1rem;
    line-height: 1.3;
    color: var(--fg);
  }
  .subtitle {
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
