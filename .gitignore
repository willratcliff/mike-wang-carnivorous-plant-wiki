# Credentials — never commit
*creds*
*credentials*
*.secret
*.secrets
.env
.env.*

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Python (likely tooling)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node (if we use a static site generator)
node_modules/

# Build outputs — _site is generated; rebuild with scripts/build_site.py
_site/
dist/
build/
.cache/

# Local scratch
scratch/
tmp/

# Data — raw HTML and images are large/regenerable; track only parsed JSON
data/raw/
data/images/
# Keep parsed/ tracked
!data/parsed/
!data/parsed/**

# Python venv (also in earlier section but explicit)
.venv/

# Claude Code session state
.claude/
